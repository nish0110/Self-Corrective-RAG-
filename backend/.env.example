# Copy this file to .env and fill in your keys.

# ---------------- LLM ----------------
# groq (free tier, fast)  |  gemini (free tier)  |  openai  |  ollama (local, free)  |  openrouter  |  mock (offline demo, no key)
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional overrides (sensible defaults are chosen per provider):
# LLM_MODEL=openai/gpt-oss-120b   (if a model is retired, the app picks an available one automatically)
# LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_WORKERS=4

# ---------------- Web search ----------------
# Get a free key at https://tavily.com . Without a key DuckDuckGo is used automatically.
TAVILY_API_KEY=
# auto | tavily | duckduckgo | none
WEB_SEARCH_PROVIDER=auto
WEB_RESULTS=4

# ---------------- Embeddings / vector DB ----------------
# auto (sentence-transformers if installed, else hash) | sentence_transformers | hash
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# CHROMA_DIR=./storage/chroma

# ---------------- CRAG retrieval evaluator & router ----------------
# llm | cross_encoder | embedding
EVALUATOR_BACKEND=llm
TOP_K=4
UPPER_THRESHOLD=0.7
LOWER_THRESHOLD=0.3
MAX_REWRITES=1
ENABLE_REFINEMENT=true
STRIP_THRESHOLD=0.15

# ---------------- Answer validation ----------------
ENABLE_VALIDATION=true
MAX_VALIDATION_RETRIES=1
VALIDATION_THRESHOLD=0.6
